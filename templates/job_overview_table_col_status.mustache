{{!
    @template quiz_archiver/job_overview_table_col_status

    This template renders the content of the status columns in the job overview
    table, providing information about the current state of the job, its
    progress, and the last time it was modified.

    Example context (json):
    {
        "badge_text": "Running",
        "badge_color": "primary",
        "tooltip_text": "The job is currently ...",
        "progress": "42"
    }
}}

<span
    class="badge badge-{{badge_color}}"
    data-toggle="tooltip"
    data-placement="top"
    data-bs-toggle="tooltip"
    data-bs-placement="top"
    title="{{tooltip_text}}"
>
    {{badge_text}}
</span>
</br>
{{#progress}}
    <span title="{{#str}} progress, quiz_archiver {{/str}}">
        <i class="fa fa-spinner fa-spin"></i>&nbsp;{{progress}}%
    </span>
    </br>
{{/progress}}
<small>
    {{#userdate}} {{time_modified}}, %c {{/userdate}}
</small>
