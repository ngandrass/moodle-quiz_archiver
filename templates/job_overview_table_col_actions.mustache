{{!
    @template quiz_archiver/job_overview_table_col_actions

    This template renders the content of the action columns in the job overview
    table, providing buttons to view job details, inspect artifacts, download
    their archive or delete the job.

    Example context (json):
    {
        "job_id": "19b2d386-a233-11f1-b356-88f4dadc5627",
        "show_content_url": "https://moodle.example/..."
        "artifact_url": "https://moodle.example/..."
        "delete_url": "https://moodle.example/..."
    }
}}

{{! Action: Show details. }}
<a
    href="#"
    id="job-details-{{job_id}}"
    class="btn btn-primary mx-1"
    role="button"
    data-toggle="tooltip"
    data-placement="top"
    data-bs-toggle="tooltip"
    data-bs-placement="top"
    title="{{#str}} showdetails, admin {{/str}}"
    alt="{{#str}} showdetails, admin {{/str}}"
>
    <i class="fa fa-info-circle"></i>
</a>


{{! Action: Show content. }}
<a
    {{#show_content_url}}
        href="{{show_content_url}}"
        class="btn btn-primary mx-1"
        data-toggle="tooltip"
        data-placement="top"
        data-bs-toggle="tooltip"
        data-bs-placement="top"
        title="{{#str}} inspect_archive_contents, quiz_archiver {{/str}}"
    {{/show_content_url}}
    {{^show_content_url}}
        href="#"
        class="btn btn-outline-primary mx-1 disabled"
        disabled
        aria-disabled="true"
    {{/show_content_url}}
    target="_blank"
    role="button"
    alt="{{#str}} inspect_archive_contents, quiz_archiver {{/str}}"
>
    <i class="fa fa-magnifying-glass"></i>
</a>

{{! Action: Download. }}
<a
    {{#artifact_url}}
        href="{{artifact_url}}"
        class="btn btn-success mx-1"
        data-toggle="tooltip"
        data-placement="top"
        data-bs-toggle="tooltip"
        data-bs-placement="top"
        title="{{#str}} download {{/str}}"
    {{/artifact_url}}
    {{^artifact_url}}
        href="#"
        class="btn btn-outline-success mx-1 disabled"
        disabled
        aria-disabled="true"
    {{/artifact_url}}
    target="_blank"
    role="button"
    alt="{{#str}} download {{/str}}"
>
    <i class="fa fa-download"></i>
</a>

{{! Action: Delete. }}
<a
    href="{{delete_url}}"
    class="btn btn-danger mx-1"
    role="button"
    data-toggle="tooltip"
    data-placement="top"
    data-bs-toggle="tooltip"
    data-bs-placement="top"
    title="{{#str}} delete {{/str}}"
    alt="{{#str}} delete {{/str}}"
>
    <i class="fa fa-times"></i>
</a>
