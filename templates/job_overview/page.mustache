{{!
    @template quiz_archiver/job_overview/page

    This template renders an overview of all previous archive jobs relating to a
    specific quiz on its report page.
    Any unfinished jobs information is automatically updated, by polling its
    current state via Ajax and replacing old content until it is finished.

    Example context (json):
    {
        "archiveQuizForm": "<!-- Generated Moodle form HTML -->",
        "baseurl": "https://example.com/mod/quiz/archiver/",
        "jobOverviewTable": "<!-- Generated Moodle table HTML -->"
    }
}}

{{! Quiz archive form }}
<div class="quiz_archiver-archive-quiz-form mb-4">
    {{{archiveQuizForm}}}
</div>

{{! List of existing archives }}
{{#jobOverviewTable}}
<h1 class="mb-3">
    {{#str}} job_overview, quiz_archiver {{/str}}
    <a
        href="{{baseurl}}"
        class="small mx-2"
        title="{{#str}} refresh, moodle {{/str}}"
        {{! Remove data-toggle and data-placement after Moodle 4.5 (LTS) deprecation }}
        data-toggle="tooltip"
        data-placement="top"
        data-bs-toggle="tooltip"
        data-bs-placement="top"
    >
        <i class="fa fa-rotate-right"></i>
    </a>
</h1>

<div class="quiz_archiver-job-overview-table">
    {{{jobOverviewTable}}}
</div>

{{#js}}
    require(['quiz_archiver/jobupdate'], (JobUpdate) => JobUpdate.init());
{{/js}}

{{/jobOverviewTable}}
