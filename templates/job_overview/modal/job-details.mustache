<table class="table w-100">
    {{! Row: JobID }}
    <tr>
        <td class="border-top-0">{{#str}} jobid, quiz_archiver {{/str}}</td>
        <td class="border-top-0">{{jobid}}</td>
    </tr>

    {{! Row: Status }}
    {{#status}}
        <tr>
            <td>{{#str}} status {{/str}}</td>
            <td>
                <span data-ref="status-modal" data-jobid="{{jobid}}">
                        {{> quiz_archiver/job_overview/fragment/status }}
                </span>
            </td>
        </tr>
    {{/status}}

    {{! Row: Course }}
    <tr>
        <td>{{#str}} course {{/str}}</td>
        <td>
            <a href="{{{actionurls.course}}}" target="_blank">
                {{course.name}}
            </a>
        </td>
    </tr>

    {{! Row: Quiz }}
    <tr>
        <td>{{#str}} modulename, mod_quiz {{/str}}</td>
        <td>
            <a href="{{{actionurls.quiz}}}" target="_blank">
                {{quiz.name}}
            </a>
        </td>
    </tr>

    {{! Row: User }}
    <tr>
        <td>{{#str}} user {{/str}}</td>
        <td>
            <a href="{{{actionurls.user}}}" target="_blank">
                {{user.firstname}} {{user.lastname}} ({{user.username}})
            </a>
        </td>
    </tr>

    {{! Row: Created time }}
    <tr>
        <td>{{#str}} timecreated {{/str}}</td>
        <td>{{#userdate}} {{timecreated}}, {{#str}} strftimedatetimeaccurate, core_langconfig {{/str}} {{/userdate}}</td>
    </tr>

    {{! Row: Modified time }}
    <tr>
        <td>{{#str}} timemodified, reportbuilder {{/str}} </td>
        <td>
            <span data-ref="timemodified-modal" data-jobid="{{jobid}}">
        {{#userdate}} {{timemodified}}, {{#str}} strftimedatetimeaccurate, core_langconfig {{/str}} {{/userdate}}
        </span>
        </td>
    </tr>

    {{! Row: Archive artifact }}
    <tr>
        <td class="align-middle">{{#str}} quiz_archive, quiz_archiver {{/str}}</td>
        <td>
            <span data-ref="archive-modal" data-jobid="{{jobid}}">
                {{> quiz_archiver/job_overview/fragment/artifact }}
            </span>
        </td>
    </tr>

    {{! Row: Archive signature }}
    <tr>
        <td class="align-middle">{{#str}} archive_signature, quiz_archiver {{/str}}</td>
        <td>
            <span data-ref="signature-modal" data-jobid="{{jobid}}">
                {{> quiz_archiver/job_overview/fragment/signature }}
            </span>
        </td>
    </tr>

    {{! Row: Archive deletion mode }}
    <tr>
        <td>{{#str}} archive_autodelete_short, quiz_archiver {{/str}}</td>
        <td>{{autodelete.str}}</td>
    </tr>

    {{! Row: Settings }}
    <tr>
        <td class="border-bottom-0 align-middle">{{#str}} settings {{/str}}</td>
        <td class="border-bottom-0">
            <ul class="list-group small">
                {{#settings}}
                    <li class="list-group-item d-flex justify-content-between align-items-center p-2">
                        {{title}}
                        <span class="badge badge-{{color}} badge-pill">{{value}}</span>
                    </li>
                {{/settings}}
                {{^settings}}
                    <li class="list-group-item">{{#str}} not_signed, quiz_archiver {{/str}}</li>
                {{/settings}}
            </ul>
        </td>
    </tr>

    {{! Row: Delete action button }}
    <tr>
        <td class="border-0 py-0"></td>
        <td class="border-0 py-0 text-right">
            <a href="{{{actionurls.job_delete}}}" class="btn btn-danger mx-1" role="button" title="{{#str}} delete {{/str}}">
                {{#str}} delete {{/str}}
            </a>
        </td>
    </tr>
</table>
