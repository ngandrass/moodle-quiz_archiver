{{!
    @template quiz_archiver/job_overview/fragment/actions

    This template renders a representation of actions available for a job,
    providing buttons to view job details, inspect artifacts, download their
    archive or delete the job.

    Example context (json):
    {
        "job_id": "19b2d386-a233-11f1-b356-88f4dadc5627",
        "show_content_url": "https://moodle.example/...",
        "artifact_url": "https://moodle.example/...",
        "delete_url": "https://moodle.example/..."
    }
}}

{{! Action: Show details. }}
<a
    href="#"
    data-ref="job-details-action" data-jobid="{{job_id}}"
    class="btn btn-primary mx-1"
    role="button"
    data-toggle="tooltip"
    data-placement="top"
    data-bs-toggle="tooltip"
    data-bs-placement="top"
    title="{{#str}} showdetails, admin {{/str}}"
    aria-label="{{#str}} showdetails, admin {{/str}}"
>
    <i class="fa fa-info-circle"></i>
</a>


{{! Action: Show content. }}
<a
    {{#show_content_url}}
        href="{{show_content_url}}"
        class="btn btn-primary mx-1"
        data-toggle="tooltip"
        data-placement="top"
        data-bs-toggle="tooltip"
        data-bs-placement="top"
        title="{{#str}} inspect_archive_contents, quiz_archiver {{/str}}"
    {{/show_content_url}}
    {{^show_content_url}}
        href="#"
        class="btn btn-outline-primary mx-1 disabled"
        disabled
        aria-disabled="true"
    {{/show_content_url}}
    target="_blank"
    role="button"
    aria-label="{{#str}} inspect_archive_contents, quiz_archiver {{/str}}"
>
    <i class="fa fa-magnifying-glass"></i>
</a>

{{! Action: Download. }}
<a
    {{#artifact_url}}
        href="{{artifact_url}}"
        class="btn btn-success mx-1"
        data-toggle="tooltip"
        data-placement="top"
        data-bs-toggle="tooltip"
        data-bs-placement="top"
        title="{{#str}} download {{/str}}"
    {{/artifact_url}}
    {{^artifact_url}}
        href="#"
        class="btn btn-outline-success mx-1 disabled"
        disabled
        aria-disabled="true"
    {{/artifact_url}}
    target="_blank"
    role="button"
    aria-label="{{#str}} download {{/str}}"
>
    <i class="fa fa-download"></i>
</a>

{{! Action: Delete. }}
<a
    href="{{delete_url}}"
    class="btn btn-danger mx-1"
    role="button"
    data-toggle="tooltip"
    data-placement="top"
    data-bs-toggle="tooltip"
    data-bs-placement="top"
    title="{{#str}} delete {{/str}}"
    aria-label="{{#str}} delete {{/str}}"
>
    <i class="fa fa-times"></i>
</a>

{{#js}}
require(
    [
        'jquery',
        'core/modal',
        'core/templates',
        'core/ajax',
        'core/notification',
        'core/str'
    ],
    function(
        $,
        Modal,
        Templates,
        AJAX,
        notification,
        Str
    ) {
        $('[data-ref="job-details-action"][data-jobid="{{job_id}}"]').click(async() => {
            // Fetch the job's current data, then render the details modal from
            // it so that it always reflects the job's latest state.
            let data;
            try {
                data = await AJAX.call([{
                    methodname: 'quiz_archiver_get_job_metadata',
                    args: {jobid: '{{job_id}}'},
                }])[0];
            } catch (e) {
                notification.exception(e);
                return;
            }

            if (data.status !== 'OK' || !data.job) {
                notification.exception(new Error(data.status || 'Unknown error'));
                return;
            }

            // Assemble the modal context from the fetched job data. The shape
            // matches the webservice exactly, so the modal templates render it
            // without any further translation.
            let job = data.job;
            let status = job.status_display_args;
            let progress = status.statusextras && status.statusextras.progress !== undefined
                ? status.statusextras.progress
                : null;
            let context = {
                jobid: job.uuid,
                status: {
                    "badge_text": status.text,
                    "badge_color": status.color,
                    "tooltip_text": status.help,
                    progress: progress,
                    "has_progress": progress !== null
                },
                timecreated: job.timecreated,
                timemodified: job.timemodified,
                user: job.user,
                course: job.course,
                quiz: job.quiz,
                settings: job.settings,
                signature: job.signature,
                autodelete: job.autodelete,
                actionurls: job.actionurls
            };
            if (job.artifact) {
                context.artifact = job.artifact;
            }

            await Modal.create({
                title: Str.getString('quiz_archive_details', 'quiz_archiver'),
                body: Templates.render('quiz_archiver/job_overview/modal/job-details', context),
                show: true,
                large: true,
                removeOnClose: true,
            });
        });
    }
);
{{/js}}