{{!
    @template quiz_archiver/job_overview/fragment/status

    This template renders a representation of a jobs status, providing
    information about the current state of the job, its progress, and optionally
    the last time it was modified.

    Example context (json):
    {
        "badge_text": "Running",
        "badge_color": "primary",
        "tooltip_text": "The job is currently ...",
        "progress": "42",
        "has_progress": true,
        "time_modified": "1445378400"
    }
}}

<span
    class="badge badge-{{badge_color}}"
    data-toggle="tooltip"
    data-placement="top"
    data-bs-toggle="tooltip"
    data-bs-placement="top"
    title="{{tooltip_text}}"
>
    {{badge_text}}
</span>
<br/>
{{#has_progress}}
    <span title="{{#str}} progress, quiz_archiver {{/str}}">
        <i class="fa fa-spinner fa-spin"></i>&nbsp;{{progress}}%
    </span>
    <br/>
{{/has_progress}}
{{#time_modified}}
<small>
    {{#userdate}} {{time_modified}}, %c {{/userdate}}
</small>
{{/time_modified}}
