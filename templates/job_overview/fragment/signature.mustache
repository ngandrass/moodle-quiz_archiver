{{!
    @template quiz_archiver/job_overview/fragment/signature

    Renders a representation of the archive tps signature of a job.
    If an artifact is present and TSP-signed, shows the signature details
    (timestamp, signer, query/reply file downloads) as well as corresponding
    actions. If not signed yet, the action is to sign it (if enabled). When no
    artifact is available defaults to absence notice.

    Example context (json):
    {
        "artifact": {
            "name": "quiz_archive_cid31_cmid108_qid36_2023-07-26_113348.tar.gz"
        },
        "signature": {
            "enabled": true,
            "tsp": {
                "timecreated": 1690805384,
                "server": "https://example.com/tsr"
            }
        },
        "actionurls": {
            "artifact_sign": "http:\/\/127.0.0.1\/mod\/quiz\/report.php?id=108\u0026mode=archiver\u0026action=sign_job\u0026jobid=32979c0a-2b97-11ee-b5db-0242ac150004",
            "tsp_query_download": "http:\/\/127.0.0.1\/pluginfile.php\/...",
            "tsp_reply_download": "http:\/\/127.0.0.1\/pluginfile.php\/..."
        },
        "autodelete": {
            "enabled": true,
            "done": false
        }
    }
}}

{{#artifact}}
    {{#signature.tsp}}
        {{#str}} signed_on, quiz_archiver {{/str}}
        <pre style="display: inline;">{{#userdate}} {{signature.tsp.timecreated}}, {{#str}} strftimedatetimeaccurate, core_langconfig {{/str}} {{/userdate}}</pre>
        {{#str}} signed_by, quiz_archiver {{/str}}
        <pre style="display: inline;">{{signature.tsp.server}}</pre>
        <br>
        {{#str}} download {{/str}}:
        <a href="{{actionurls.tsp_query_download}}" target="_blank">
            {{#pix}} a/download_all, core, {{#str}} downloadfile {{/str}} {{/pix}}{{#str}} tsp_query_filename, quiz_archiver {{/str}}
        </a>
        &nbsp;&ndash;&nbsp;
        <a href="{{actionurls.tsp_reply_download}}" target="_blank">
            {{#pix}} a/download_all, core, {{#str}} downloadfile {{/str}} {{/pix}}{{#str}} tsp_reply_filename, quiz_archiver {{/str}}
        </a>
    {{/signature.tsp}}
    {{^signature.tsp}}
        <i>{{#str}} archive_not_signed, quiz_archiver {{/str}}</i>
        {{#signature.enabled}}
            &nbsp;&ndash;&nbsp;
            <a href="{{actionurls.artifact_sign}}">{{#pix}} t/edit, core, {{#str}} sign_archive, quiz_archiver {{/str}} {{/pix}}{{#str}} sign_archive, quiz_archiver {{/str}}</a>
        {{/signature.enabled}}
    {{/signature.tsp}}
{{/artifact}}
{{^artifact}}
    {{#autodelete.done}}
        <i>{{#str}} archive_deleted, quiz_archiver {{/str}}</i>
    {{/autodelete.done}}
    {{^autodelete.done}}
        <i>{{#str}} quiz_archive_not_ready, quiz_archiver {{/str}}</i>
    {{/autodelete.done}}
{{/artifact}}
